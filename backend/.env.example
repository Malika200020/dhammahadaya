PGHOST=localhost
PGPORT=5432
PGDATABASE=dhammahadaya
PGUSER=dhammahadaya_app
PGPASSWORD=

PORT=4000
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# local | r2 — see backend/src/storage/. local writes to backend/uploads/
# (fine for dev, not for production — files live on the app server disk).
# r2 sends to Cloudflare R2 via the S3-compatible API; requires the R2_*
# vars below.
STORAGE_DRIVER=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# The bucket's public r2.dev URL, or a custom domain fronting it — whatever
# saved files should be served from (no trailing slash).
R2_PUBLIC_URL=

# console | smtp — see backend/src/email/. console just logs (dev default).
# smtp sends via nodemailer against any standard SMTP relay (SES's SMTP
# endpoint, Postmark, Mailgun, a real mailbox, etc.) — no provider is
# hardcoded, only these credentials are needed.
EMAIL_DRIVER=console
SMTP_HOST=
SMTP_PORT=587
# true forces implicit TLS, false forces plain+STARTTLS; unset infers from
# SMTP_PORT (465 -> true, everything else -> false).
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Defaults to SMTP_USER if unset. Many providers require this to match a
# verified sending domain/address.
SMTP_FROM=

# Where "notify the monastery" emails go — a new pending sponsorship
# booking (build-spec §10), etc. Leave unset to skip that notification
# entirely (the sponsor's own confirmation email on admin approval is
# separate and always sends regardless of this).
ADMIN_NOTIFICATION_EMAIL=

# Meditation registration reCAPTCHA (build-spec §13) — off by default so
# local dev/testing isn't blocked on a live Google key. Set to true only
# once RECAPTCHA_SECRET_KEY (and the frontend's VITE_RECAPTCHA_SITE_KEY)
# are configured with real keys from https://www.google.com/recaptcha/admin.
RECAPTCHA_ENABLED=false
RECAPTCHA_SECRET_KEY=

# Admin login email-OTP two-factor (build-spec §19) — secure by default:
# only an explicit "false" turns it off. Set to false ONLY for local dev,
# so you're not blocked reading a code out of the console on every login —
# never set this to false anywhere real.
TWO_FACTOR_ENABLED=true

# WhatsApp sponsorship-confirmation messages (build-spec §10, deferred
# half) — off by default. When "true", backend/src/whatsapp/ launches a
# whatsapp-web.js client on server startup; visit the admin's WhatsApp page
# to scan the QR and link a number. When "false" (default), none of that
# machinery even loads, and admin-sponsorship.js's WhatsApp send is simply
# skipped — the existing confirmation email always sends regardless.
WHATSAPP_ENABLED=false
# Where the linked session is persisted so a server restart doesn't force a
# re-scan. Defaults to a directory outside the repo
# (~/.dhammahadaya/whatsapp-session) — only set this if that default isn't
# writable/desired in your deployment.
WHATSAPP_SESSION_DIR=
