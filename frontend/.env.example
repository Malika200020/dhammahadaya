# Meditation registration reCAPTCHA (build-spec §13) — mirrors the
# backend's RECAPTCHA_ENABLED toggle; off by default so local dev/testing
# isn't blocked on a live Google key.
VITE_RECAPTCHA_ENABLED=false
VITE_RECAPTCHA_SITE_KEY=

# Leave unset for local dev (Vite's dev-server proxy in vite.config.js
# forwards /api to the local backend, so relative paths just work) and in
# any deployment where frontend and backend share one origin. Set to the
# backend's own URL (e.g. https://api.dhammahadaya.lk, no trailing slash)
# when they're deployed separately — Cloudflare Pages + Render, say — since
# a relative /api/... request would otherwise hit the frontend's own origin,
# which has no such route. See src/api/base.js.
VITE_API_BASE_URL=
